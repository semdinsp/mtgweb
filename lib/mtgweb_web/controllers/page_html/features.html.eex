
<section class="section">
<div class="bg-white pt-12 sm:pt-16 pb-12 sm:pb-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-semibold  text-balance tracking-tight text-pretty sm:text-4xl" style="color: rgb(29, 9, 89) !important;">Capabilities</h2>
      <p class="mt-3 text-xl sm:mt-4" style="color: rgb(29, 9, 89) !important;">Our capabilities to grow your business</p>
    </div>

    <div class="mt-10 mx-auto max-w-5xl grid grid-cols-1 sm:grid-cols-3 gap-6">
      <%= for item <- @content do %>
        <div class="rounded-2xl border-2 border-orange-400/50 hover:border-orange-400 transition-all duration-300 p-6 text-center" style="background-color: rgb(24, 7, 74) !important;">
          <div class="text-orange-400 text-sm font-bold italic mb-2"><%= item.title %></div>
          <div class="text-white text-lg font-semibold tracking-tight"><%= item.content %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
</section>
